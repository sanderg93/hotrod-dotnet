<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Resolve packages only from the official nuget.org feed; ignore any machine/user-level feeds. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Re-enable nuget.org even if a machine/user-level config disabled it, so restores here always resolve. -->
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
