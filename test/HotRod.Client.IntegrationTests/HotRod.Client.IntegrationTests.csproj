<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers" Version="4.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HotRod.Client\HotRod.Client.csproj" />
  </ItemGroup>

  <!-- The Infinispan server configuration and its credential files travel next to the test
       assembly so the container fixture can mount them without a solution-relative lookup. -->
  <ItemGroup>
    <Content Include="containerconfig\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>containerconfig\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

</Project>
