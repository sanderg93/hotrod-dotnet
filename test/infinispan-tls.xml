<infinispan
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns="urn:infinispan:config:16.0"
      xmlns:server="urn:infinispan:server:16.0">

   <cache-container name="default" statistics="true">
      <local-cache name="default"/>
   </cache-container>

   <server xmlns="urn:infinispan:server:16.0">
      <interfaces>
         <interface name="public">
            <inet-address value="${infinispan.bind.address:0.0.0.0}"/>
         </interface>
      </interfaces>

      <socket-bindings default-interface="public" port-offset="0">
         <socket-binding name="default" port="11222"/>
      </socket-bindings>

      <security>
         <security-realms>
            <security-realm name="default">
               <!-- An SSL server identity turns on TLS for every endpoint bound to this
                    realm; the keystore holds the server's certificate and private key. -->
               <server-identities>
                  <ssl>
                     <keystore path="/user-config/server.pfx"
                               keystore-password="password"
                               alias="server"/>
                  </ssl>
               </server-identities>
               <properties-realm groups-attribute="Roles">
                  <user-properties path="/user-config/scram-users.properties"/>
                  <group-properties path="/user-config/scram-groups.properties"/>
               </properties-realm>
            </security-realm>
         </security-realms>
      </security>

      <endpoints>
         <endpoint socket-binding="default" security-realm="default">
            <hotrod-connector>
               <authentication>
                  <sasl mechanisms="SCRAM-SHA-512 SCRAM-SHA-256 DIGEST-MD5"
                        server-name="infinispan"
                        qop="auth"/>
               </authentication>
            </hotrod-connector>
            <rest-connector>
               <authentication mechanisms="DIGEST"/>
            </rest-connector>
         </endpoint>
      </endpoints>
   </server>
</infinispan>
